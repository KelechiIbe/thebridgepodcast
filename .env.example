# Browser-side (safe to expose). Leave both empty to run the studio in local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (set these in Netlify > Site configuration > Environment variables).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters. Encrypts API keys saved from the Settings page.
APP_SECRET=
# Optional fallbacks. Keys saved in Settings take priority.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
