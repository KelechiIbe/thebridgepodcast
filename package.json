{
  "name": "the-bridge-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Studio for turning The Bridge open-office notes into AI-voiced podcast episodes with synced visuals.",
  "scripts": {
    "dev": "npm run build:player && vite",
    "build": "npm run build:player && tsc -b && vite build",
    "build:player": "vite build --config vite.player.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@supabase/supabase-js": "2.117.3",
    "mammoth": "1.13.0",
    "mediabunny": "1.61.4",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
