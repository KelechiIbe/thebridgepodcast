# Browser-side (safe to expose). Leave both empty to run the studio in local demo mode.
VITE_SUPABASE_URL=
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...). The older anon key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (set these in Netlify > Project configuration > Environment variables).
# Supabase > Project Settings > API Keys > Secret key (sb_secret_...). The older service_role key also works.
SUPABASE_SECRET_KEY=
# 32+ random characters. Encrypts API keys saved from the Settings page.
APP_SECRET=
# Optional fallbacks. Keys saved in Settings take priority.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
